   "source": [
    "import cv2\n",
    "\n",
    "cap = cv2.VideoCapture(0)\n",
    "\n",
    "ret, frame = cap.read()\n",
    "print(\"Camera opened:\", ret)\n",
    "\n",
    "if ret:\n",
    "    cv2.imshow(\"Test Camera\", frame)\n",
    "    cv2.waitKey(0)\n",
    "\n",
    "cap.release()\n",
    "cv2.destroyAllWindows()"
   ]
